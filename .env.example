# Konfigurasi Keamanan JWT
JWT_SECRET=rahasia-jwt-skripsi-monitoring-2026-super-secure

# Konfigurasi Google OAuth 2.0 (Agar Setiap Dosen Bisa Menghubungkan Google Drive Pribadi)
# Didapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
GOOGLE_CLIENT_ID=masukkan_client_id_google_disini.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=masukkan_client_secret_google_disini
